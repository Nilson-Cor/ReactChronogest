cat > frontend/.env << 'EOF'
REACT_APP_API_URL=https://fictional-system-5gv59j796446c769j-5000.app.github.dev
EOF

# 2. IMPORTANTE: Reconstruye el frontend (no solo reiniciar)
docker-compose down
docker-compose up --build -d

# 3. Espera 60 segundos
sleep 60

# 4. Verifica que se aplicó
docker-compose exec frontend sh -c "echo \$REACT_APP_API_URL"